    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "mocha": "^11.7.6",
    "chai": "^4.5.0",
    "@types/mocha": "^10.0.10",
    "@types/chai": "^4.3.20",
    "@types/node": "^22.10.7",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4",
    "litesvm": "^1.2.1",
    "anchor-litesvm": "^0.2.1"
  }
